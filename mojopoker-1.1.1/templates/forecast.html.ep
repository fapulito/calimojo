<!-- Copyright (C) 2026, California Vision — Forecast page (Session 2). Play money only. -->
<!DOCTYPE html>
<html>
<head>
    <title>Forecast - Play Money Markets</title>
    <meta http-equiv="Content-Type" content="text/html; charset=us-ascii">
    <link rel="stylesheet" href="forecast.css" type="text/css">
</head>
<body>
    <div id="fc-app">
        <div id="fc-head">
            <a id="fc-back" href="/">Back to poker</a>
            <h1>Forecast</h1>
            <div id="fc-wallet">Balance: <span id="fc-balance">&hellip;</span> play tokens (<span id="fc-user">&hellip;</span>)</div>
        </div>
        <div id="fc-status">Connecting&hellip;</div>
        <h2>Open questions</h2>
        <div id="fc-open"><p class="fc-empty">Loading&hellip;</p></div>
        <div id="fc-admin" style="display:none">
            <h2>Draft approval queue (admin)</h2>
            <div id="fc-generate-row">
                <select id="fc-topic">
                    <option value="">All topics</option>
                    <option value="economics">Economics</option>
                    <option value="tech">Tech</option>
                    <option value="culture">Culture</option>
                    <option value="weather">Weather</option>
                </select>
                <button id="fc-generate-btn">Generate drafts</button>
            </div>
            <div id="fc-drafts"></div>
        </div>
    </div>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.0.0/jquery.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="forecast.js"></script>
    <script>
        $(document).ready(function() {
            Forecast.init({ ws: "<%= $ws_url %>" });
        });
    </script>
</body>
</html>
