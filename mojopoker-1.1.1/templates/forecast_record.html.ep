<!DOCTYPE html>
<html>
<head>
    <title>Resolution record - Forecast</title>
    <meta http-equiv="Content-Type" content="text/html; charset=us-ascii">
    <link rel="stylesheet" href="/forecast.css" type="text/css">
</head>
<body>
    <div id="fc-app">
        <div id="fc-head">
            <a id="fc-back" href="/forecast">Back to forecast</a>
            <h1>Resolution record</h1>
        </div>
        <div id="fc-status">Connecting&hellip;</div>
        <div id="fc-record"><p class="fc-empty">Loading&hellip;</p></div>
        <div id="fc-actions" style="display:none">
            <h2>Challenge this resolution</h2>
            <div class="fc-challenge-form">
                <textarea id="fc-challenge-reason" placeholder="Why is this resolution wrong? Cite sources."></textarea><br>
                <button id="fc-challenge-btn">File challenge</button>
                <span class="fc-msg"></span>
            </div>
            <h2>Settlement</h2>
            <div><button id="fc-settle-btn">Settle now</button> <span class="fc-msg"></span></div>
        </div>
    </div>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.0.0/jquery.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="/forecast_record.js"></script>
    <script>
        $(document).ready(function() {
            ForecastRecord.init({ ws: "<%= $ws_url %>", id: "<%= $record_id %>" });
        });
    </script>
</body>
</html>
